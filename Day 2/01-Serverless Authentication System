3.5.2 – Create lambda_function.py

Execute this entire command:

cat > lambda_function.py <<'PY'
import json
import os
import boto3
import hashlib
import base64
import hmac

dynamodb = boto3.resource("dynamodb")

table = dynamodb.Table(
    os.environ.get("TABLE_NAME", "training-auth-users")
)

ITERATIONS = 600000


def response(status_code, body):
    return {
        "statusCode": status_code,
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "Content-Type",
            "Access-Control-Allow-Methods": "OPTIONS,POST"
        },
        "body": json.dumps(body)
    }


def verify_password(password, stored_value):
    try:
        salt_value, hash_value = stored_value.split(":")

        salt = base64.b64decode(salt_value, validate=True)
        stored_hash = base64.b64decode(hash_value, validate=True)

        if len(salt) != 16 or len(stored_hash) != 32:
            return False

        new_hash = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            salt,
            ITERATIONS
        )

        return hmac.compare_digest(new_hash, stored_hash)

    except (ValueError, TypeError):
        return False


def lambda_handler(event, context):

    if event.get("httpMethod") == "OPTIONS":
        return response(200, {"message": "OK"})

    try:
        body = event.get("body") or "{}"

        if event.get("isBase64Encoded"):
            body = base64.b64decode(body).decode("utf-8")

        data = json.loads(body)

        username = data.get("username", "")
        password = data.get("password", "")

        if (
            not isinstance(username, str)
            or not isinstance(password, str)
            or not username
            or not password
            or len(username) > 100
            or len(password) > 256
        ):
            return response(400, {
                "success": False,
                "message": "Username and password are required"
            })

        result = table.get_item(
            Key={"username": username}
        )

        user = result.get("Item")

        stored_value = (
            user.get("password_hash", "")
            if user else
            "AAAAAAAAAAAAAAAAAAAAAA==:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        )

        password_valid = verify_password(password, stored_value)

        if (
            not user
            or not password_valid
            or user.get("status") != "ACTIVE"
        ):
            return response(401, {
                "success": False,
                "message": "Invalid username or password"
            })

        return response(200, {
            "success": True,
            "message": "Login successful",
            "user": {
                "username": user["username"],
                "full_name": user.get("full_name", ""),
                "email": user.get("email", ""),
                "role": user.get("role", "student")
            }
        })

    except Exception:
        print("Authentication request failed")
        return response(500, {
            "success": False,
            "message": "Internal server error"
        })
PY


