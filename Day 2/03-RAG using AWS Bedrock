Step 14.3 – Create the Lambda function code
Purpose: This Python function will receive a question from the chatbot, send it to your Bedrock Knowledge Base using RetrieveAndGenerate, and return the generated answer along with its source references.

In your existing frontend directory, run:


cat > lambda_function.py <<'PY'
import json
import os
import logging
import boto3

# Configure application logging
logger = logging.getLogger()
logger.setLevel(logging.INFO)

# Initialize Amazon Bedrock Agent Runtime client
bedrock = boto3.client(
    "bedrock-agent-runtime",
    region_name=os.environ["BEDROCK_REGION"]
)


def lambda_handler(event, context):
    try:
        # Read the incoming API Gateway request
        body = json.loads(event.get("body") or "{}")
        question = body.get("question", "").strip()

        # Validate user input
        if not question:
            return response(400, {
                "error": "Please enter a question."
            })

        logger.info("Received chatbot question")

        # Retrieve relevant documents and generate an answer
        result = bedrock.retrieve_and_generate(
            input={
                "text": question
            },
            retrieveAndGenerateConfiguration={
                "type": "KNOWLEDGE_BASE",
                "knowledgeBaseConfiguration": {
                    "knowledgeBaseId": os.environ["KB_ID"],
                    "modelArn": os.environ["LLM_INFERENCE_PROFILE_ARN"]
                }
            }
        )

        # Extract generated answer
        answer = result["output"]["text"]

        # Extract source document references
        sources = []

        for citation in result.get("citations", []):
            for reference in citation.get("retrievedReferences", []):

                location = reference.get("location", {})
                s3_location = location.get("s3Location", {})

                sources.append({
                    "text": reference.get("content", {}).get("text", ""),
                    "source": s3_location.get("uri", "")
                })

        logger.info("Bedrock response generated successfully")

        return response(200, {
            "answer": answer,
            "sources": sources
        })

    except Exception as e:
        # Log complete exception details in CloudWatch
        logger.exception("Chatbot processing failed")

        return response(500, {
            "error": f"{type(e).__name__}: {str(e)}"
        })


def response(status_code, body):
    return {
        "statusCode": status_code,
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "body": json.dumps(body)
    }
PY


