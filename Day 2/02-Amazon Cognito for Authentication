Step 4.3 – Update Dashboard.html
4.3.1 What are we doing?
    After successful authentication, Cognito returns three tokens:
    - ID Token: Contains authenticated user information.
    - Access Token: Used to authorize access to Cognito resources.
    - Refresh Token: Used to obtain new tokens when existing tokens expire.
    We will update Dashboard.html to:
    1. Check whether Cognito authentication tokens exist.
    2. Decode the ID Token to display student information.
    3. Display username and email.
    4. Provide a Logout button.
    5. Redirect unauthenticated users to login.html.
4.3.2 Replace Dashboard.html
Execute this complete command:


cat > Dashboard.html <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard - Cognito</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eef2f7;
            margin: 0;
        }

        .header {
            background: #1e3a5f;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .container {
            max-width: 700px;
            margin: 60px auto;
            padding: 30px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .details {
            background: #f1f5f9;
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
        }

        button {
            padding: 10px 20px;
            background: #dc2626;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<div class="header">
    <h2>Student Dashboard</h2>
    <button onclick="logout()">Logout</button>
</div>

<div class="container">

    <h1>Welcome!</h1>

    <p>You have successfully logged in through Amazon Cognito.</p>

    <div class="details">
        <h3>Authenticated User Information</h3>

        <p><strong>Username:</strong> <span id="username"></span></p>
        <p><strong>Email:</strong> <span id="email"></span></p>
        <p><strong>Name:</strong> <span id="name"></span></p>
        <p><strong>Authentication:</strong> Amazon Cognito</p>
    </div>

</div>

<script>

function decodeToken(token) {

    const payload = token.split(".")[1];

    const base64 = payload
        .replace(/-/g, "+")
        .replace(/_/g, "/");

    return JSON.parse(
        decodeURIComponent(
            atob(base64)
                .split("")
                .map(c => "%" +
                    c.charCodeAt(0).toString(16).padStart(2, "0"))
                .join("")
        )
    );
}

const tokens = sessionStorage.getItem("cognito_tokens");

if (!tokens) {

    window.location.replace("login.html");

} else {

    try {

        const authentication = JSON.parse(tokens);

        if (!authentication.IdToken) {
            throw new Error("ID token missing");
        }

        const user = decodeToken(authentication.IdToken);

        if (user.token_use !== "id" ||
            !user.exp ||
            user.exp <= Math.floor(Date.now() / 1000)) {
            throw new Error("Invalid or expired ID token");
        }

        document.getElementById("username").textContent =
            user["cognito:username"] || user.username || "";

        document.getElementById("email").textContent =
            user.email || "Not provided";

        document.getElementById("name").textContent =
            user.name || "Not provided";

    } catch (error) {

        sessionStorage.removeItem("cognito_tokens");
        sessionStorage.removeItem("cognito_username");

        window.location.replace("login.html");
    }
}

function logout() {

    sessionStorage.removeItem("cognito_tokens");
    sessionStorage.removeItem("cognito_username");

    window.location.replace("login.html");
}

</script>

</body>
</html>
