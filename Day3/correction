Step 15A – Create the Lambda source code
From your existing StudentAgent directory, run this command:

export LAMBDA_FUNCTION_NAME="StudentLookupTool"
export LAMBDA_CODE_DIR="student-lookup-lambda"

mkdir -p "$LAMBDA_CODE_DIR"

cat > "$LAMBDA_CODE_DIR/lambda_function.py" <<'EOF'
import os
import boto3
from decimal import Decimal
from boto3.dynamodb.conditions import Key

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table(os.environ["STUDENT_TABLE_NAME"])


def json_safe(value):
    if isinstance(value, Decimal):
        return int(value) if value % 1 == 0 else float(value)

    if isinstance(value, list):
        return [json_safe(item) for item in value]

    if isinstance(value, dict):
        return {key: json_safe(item) for key, item in value.items()}

    return value


def lambda_handler(event, context):
    class_name = event.get("class_name")

    if not class_name:
        return {
            "error": "class_name is required"
        }

    response = table.query(
        IndexName="ClassScoreIndex",
        KeyConditionExpression=Key("Class").eq(str(class_name)),
        ScanIndexForward=False
    )

    students = response.get("Items", [])

    return {
        "class_name": str(class_name),
        "student_count": len(students),
        "students": json_safe(students)
    }
EOF

