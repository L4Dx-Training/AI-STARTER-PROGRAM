<script>
const API_URL = "__API_URL__";

const chatArea = document.getElementById("chatArea");
const chatForm = document.getElementById("chatForm");
const messageInput = document.getElementById("messageInput");
const sendButton = chatForm.querySelector("button");

let sessionId = sessionStorage.getItem("studentAgentSession");

if (!sessionId) {
    sessionId = crypto.randomUUID();
    sessionStorage.setItem("studentAgentSession", sessionId);
}

function addMessage(message, type) {
    const element = document.createElement("div");
    element.className = `message ${type}`;
    element.textContent = message;
    chatArea.appendChild(element);
    chatArea.scrollTop = chatArea.scrollHeight;
    return element;
}

function extractText(response) {
    const lines = response.split(/\r?\n/);
    const texts = [];

    for (const line of lines) {
        if (!line.startsWith("data:")) continue;

        const data = line.substring(5).trim();
        if (!data || data === "[DONE]") continue;

        try {
            const event = JSON.parse(data);
            const delta = event.event?.contentBlockDelta?.delta?.text;
            if (delta) texts.push(delta);
        } catch {
            // Ignore non-JSON SSE lines.
        }
    }

    return texts.join("") || response;
}

chatForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    const message = messageInput.value.trim();
    if (!message) return;

    addMessage(message, "user");
    messageInput.value = "";
    messageInput.disabled = true;
    sendButton.disabled = true;

    const reply = addMessage("Thinking...", "assistant");

    try {
        const response = await fetch(API_URL, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                message: message,
                sessionId: sessionId
            })
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.error || "Request failed");
        }

        sessionId = result.sessionId || sessionId;
        sessionStorage.setItem("studentAgentSession", sessionId);

        reply.textContent = extractText(result.response || "No response received.");

    } catch (error) {
        reply.textContent = "Unable to contact the AI assistant: " + error.message;
    } finally {
        messageInput.disabled = false;
        sendButton.disabled = false;
        messageInput.focus();
        chatArea.scrollTop = chatArea.scrollHeight;
    }
});
</script>
'''

script = script.replace("__API_URL__", url)

import re
html, count = re.subn(
    r"<script>.*?</script>",
    lambda match: script,
    html,
    count=1,
    flags=re.DOTALL
)

if count != 1:
    raise SystemExit("Could not find the existing script block. No changes saved.")

path.write_text(html)
print("Frontend connected to StudentAgentProxy.")
