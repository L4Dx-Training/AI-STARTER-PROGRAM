cat > ../agentcore-proxy/lambda_function.py <<'PY'
import os
import json
import uuid
import boto3

REGION = os.environ.get("AWS_REGION", "ap-south-1")
RUNTIME_ARN = os.environ["AGENTCORE_RUNTIME_ARN"]

agentcore = boto3.client(
    "bedrock-agentcore",
    region_name=REGION
)


def lambda_handler(event, context):

    headers = {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Headers": "Content-Type",
        "Access-Control-Allow-Methods": "OPTIONS,POST"
    }

    if event.get("requestContext", {}).get("http", {}).get("method") == "OPTIONS":
        return {
            "statusCode": 200,
            "headers": headers,
            "body": ""
        }

    try:
        body = json.loads(event.get("body") or "{}")
        prompt = body.get("message", "").strip()

        if not prompt:
            return {
                "statusCode": 400,
                "headers": headers,
                "body": json.dumps({"error": "Message is required"})
            }

        session_id = body.get("sessionId") or str(uuid.uuid4())

        response = agentcore.invoke_agent_runtime(
            agentRuntimeArn=RUNTIME_ARN,
            runtimeSessionId=session_id,
            payload=json.dumps({
                "prompt": prompt
            }).encode("utf-8"),
            contentType="application/json",
            accept="text/event-stream"
        )

        response_text = response["response"].read().decode("utf-8")

        return {
            "statusCode": 200,
            "headers": headers,
            "body": json.dumps({
                "response": response_text,
                "sessionId": session_id
            })
        }

    except Exception as error:
        print(f"AgentCore invocation failed: {str(error)}")

        return {
            "statusCode": 500,
            "headers": headers,
            "body": json.dumps({
                "error": "Unable to process your request."
            })
        }
PY

echo "Proxy Lambda code created."

This uses a generated session ID when the browser does not supply one. The browser can reuse that ID for subsequent messages.



