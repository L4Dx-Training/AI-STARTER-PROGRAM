echo "Installing Node.js..."
brew install node

# Install uv
echo "Installing uv..."
curl -LsSf https://astral.sh/uv/install.sh | sh

export PATH="$HOME/.local/bin:$PATH"

# Install Python 3.12 using uv
echo "Installing Python 3.12..."
uv python install 3.12

# Install AWS CLI v2
echo "Installing AWS CLI..."
