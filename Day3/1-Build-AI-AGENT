Step 6 – Create Student Lookup Lambda code
Now we will create one Python Lambda function that acts as the Student Lookup Tool for our AI Agent.

This Lambda will support two operations:
1. list_students – Retrieve all students or students belonging to a particular class.
2. get_student – Retrieve an individual student using Student ID.
We will use the same Lambda as a single tool for our first agent.
6.1 Navigate to Lambda directory
mkdir -p ~/student-agent-demo/lambda
cd ~/student-agent-demo/lambda


6.2 Create Python file
Execute:
cat > lambda_function.py <<'EOF'
import os
import json
import boto3
from decimal import Decimal

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table(os.environ["TABLE_NAME"])

def convert_decimal(obj):
    if isinstance(obj, list):
        return [convert_decimal(i) for i in obj]
    if isinstance(obj, dict):
        return {k: convert_decimal(v) for k, v in obj.items()}
    if isinstance(obj, Decimal):
        return int(obj) if obj % 1 == 0 else float(obj)
    return obj

def lambda_handler(event, context):

    action = event.get("action")

    if action == "get_student":

        student_id = event.get("student_id")

        if not student_id:
            return {
                "error": "student_id is required"
            }

        response = table.get_item(
            Key={"student_id": student_id}
        )

        student = response.get("Item")

        if not student:
            return {
                "message": "Student not found"
            }

        return {
            "student": convert_decimal(student)
        }

    elif action == "list_students":

        class_no = event.get("class")
        students = []

        scan_params = {}

        if class_no is not None:
            from boto3.dynamodb.conditions import Attr
            scan_params["FilterExpression"] = Attr("class").eq(int(class_no))

        while True:
            response = table.scan(**scan_params)
            students.extend(response.get("Items", []))

            if "LastEvaluatedKey" not in response:
                break

            scan_params["ExclusiveStartKey"] = response["LastEvaluatedKey"]

        return {
            "count": len(students),
            "students": convert_decimal(students)
        }

    else:
        return {
            "error": "Invalid action. Use list_students or get_student."
        }
EOF


