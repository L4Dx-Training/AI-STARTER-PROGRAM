Step 10 – Create StudentLookupTool Lambda source code
Objective: Query the ClassScoreIndex GSI and return records sorted by score, highest first.
cd ~/student-ai-agent-training/StudentAgent
mkdir -p student-lookup-lambda

cat > student-lookup-lambda/lambda_function.py <<'EOF'
import os
import boto3
from decimal import Decimal
from boto3.dynamodb.conditions import Key

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table(os.environ["STUDENT_TABLE_NAME"])


def json_safe(value):
    if isinstance(value, Decimal):
        return int(value) if value % 1 == 0 else float(value)
    if isinstance(value, list):
        return [json_safe(item) for item in value]
    if isinstance(value, dict):
        return {key: json_safe(item) for key, item in value.items()}
    return value


def lambda_handler(event, context):
    class_name = str(event.get("class_name", "")).strip()
    if not class_name:
        return {"error": "class_name is required"}

    response = table.query(
        IndexName="ClassScoreIndex",
        KeyConditionExpression=Key("Class").eq(class_name),
        ScanIndexForward=False
    )
    students = response.get("Items", [])
    return {
        "class_name": class_name,
        "student_count": len(students),
        "students": json_safe(students)
    }
EOF

