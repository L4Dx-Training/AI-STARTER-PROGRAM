Step 13 – Create the Strands student_lookup tool
Objective: Invoke StudentLookupTool synchronously using Boto3.
cd ~/student-ai-agent-training/StudentAgent

cat > app/agent/student_tools.py <<'EOF'
import os
import json
import boto3
from strands import tool


@tool
def student_lookup(class_name: str) -> dict:
    """
    Find all students belonging to a particular class.
    Args:
        class_name: School class to search, such as 9 or 10.
    Returns:
        Student records ordered by score, highest first.
    """
    lambda_client = boto3.client(
        "lambda",
        region_name=os.environ.get("AWS_REGION", "ap-south-1")
    )
    response = lambda_client.invoke(
        FunctionName=os.environ.get("STUDENT_LOOKUP_LAMBDA_NAME", "StudentLookupTool"),
        InvocationType="RequestResponse",
        Payload=json.dumps({"class_name": str(class_name)}).encode("utf-8")
    )
    result_text = response["Payload"].read().decode("utf-8")
    if response.get("FunctionError"):
        raise RuntimeError(f"Student lookup Lambda failed: {result_text}")
    return json.loads(result_text)
EOF

