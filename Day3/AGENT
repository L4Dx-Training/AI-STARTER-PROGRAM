Template structure check  The source's later integration uses the imports below. Confirm the generated files and import paths exist in your current template. If your installed template version differs, preserve its generated entrypoint and add only the student_tools import and tool registration. Do not blindly overwrite a different template version.

cat > app/agent/main.py <<'EOF'
from functools import lru_cache

from strands import Agent, tool
from strands.agent.conversation_manager.null_conversation_manager import NullConversationManager
from bedrock_agentcore.runtime import BedrockAgentCoreApp

from model.load import load_model
from parse import parse_payload
from memory.session import get_memory_session_manager
from student_tools import student_lookup


DEFAULT_SYSTEM_PROMPT = """
You are a helpful school student assistant.
When a user asks about students in a particular class,
use the student_lookup tool to retrieve the records.
Present results clearly. Do not invent student records or scores.
"""


@tool
def add_numbers(a: int, b: int) -> int:
    """Return the sum of two numbers."""
    return a + b


TOOLS = [add_numbers, student_lookup]


def _make_conversation_manager():
    return NullConversationManager()


@lru_cache(maxsize=128)
def _get_agent(session_id: str, actor_id: str) -> Agent:
    return Agent(
        model=load_model(),
        session_manager=get_memory_session_manager(session_id, actor_id),
        conversation_manager=_make_conversation_manager(),
        system_prompt=DEFAULT_SYSTEM_PROMPT,
        tools=TOOLS,
    )


def create_app():
    app = BedrockAgentCoreApp()
    log = app.logger

    @app.entrypoint
    async def invoke(payload, context):
        log.info("Invoking StudentAgent")
        session_id = getattr(context, "session_id", None) or "default-session"
        prompt, actor_id = parse_payload(payload)
        agent = _get_agent(session_id, actor_id)

        async for event in agent.stream_async(prompt):
            if not isinstance(event, dict) or "event" not in event:
                continue
            cbs = event["event"].get("contentBlockStart")
            if cbs is not None and not cbs.get("start"):
                continue
            yield event

    return app


app = create_app()

if __name__ == "__main__":
    app.run()
EOF

