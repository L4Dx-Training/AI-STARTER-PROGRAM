import os
import json
import uuid
import boto3

REGION = os.environ.get("AWS_REGION", "ap-south-1")
RUNTIME_ARN = os.environ["AGENTCORE_RUNTIME_ARN"]
agentcore = boto3.client("bedrock-agentcore", region_name=REGION)


def lambda_handler(event, context):
    method = event.get("requestContext", {}).get("http", {}).get("method", "POST")
    if method != "POST":
        return {
            "statusCode": 405,
            "headers": {"Content-Type": "application/json"},
            "body": json.dumps({"error": "Method not allowed"})
        }

    try:
        body = json.loads(event.get("body") or "{}")
        prompt = body.get("message", "")
        if not isinstance(prompt, str) or not prompt.strip():
            return {
                "statusCode": 400,
                "headers": {"Content-Type": "application/json"},
                "body": json.dumps({"error": "Message is required"})
            }

        session_id = body.get("sessionId") or str(uuid.uuid4())
        if len(session_id) < 33:
            session_id = str(uuid.uuid4())

        runtime_response = agentcore.invoke_agent_runtime(
            agentRuntimeArn=RUNTIME_ARN,
            runtimeSessionId=session_id,
            payload=json.dumps({"prompt": prompt.strip()}).encode("utf-8"),
            contentType="application/json",
            accept="text/event-stream"
        )
        stream = runtime_response["response"]
        try:
            response_text = stream.read().decode("utf-8")
        finally:
            stream.close()

        return {
            "statusCode": 200,
            "headers": {
                "Content-Type": "application/json; charset=utf-8",
                "Cache-Control": "no-store"
            },
            "body": json.dumps({
                "response": response_text,
                "sessionId": runtime_response.get("runtimeSessionId", session_id)
            })
        }
    except Exception as error:
        print("AgentCore invocation failed:", repr(error))
        return {
            "statusCode": 500,
            "headers": {"Content-Type": "application/json"},
            "body": json.dumps({"error": "Unable to process your request."})
        }
PY

